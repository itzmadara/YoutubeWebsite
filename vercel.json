{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    {
      "src": "frontend/index.html",
      "use": "@vercel/static"
    },
    {
      "src": "frontend/app.js",
      "use": "@vercel/static"
    },
    {
      "src": "frontend/config.js",
      "use": "@vercel/static"
    },
    {
      "src": "frontend/styles.css",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "^/$",
      "dest": "/frontend/index.html"
    },
    {
      "src": "^/app.js$",
      "dest": "/frontend/app.js"
    },
    {
      "src": "^/config.js$",
      "dest": "/frontend/config.js"
    },
    {
      "src": "^/styles.css$",
      "dest": "/frontend/styles.css"
    }
  ]
}
